# ---------------------------------------------------------------------------
# Holoform Studio environment
# Copy to .env.local for development; set the same variables on Vercel.
# Without the Supabase variables the app runs in LOCAL DEV MODE:
# JSON file + local uploads on this machine only (never works on serverless).
# ---------------------------------------------------------------------------

# Supabase project URL (Project Settings → API → Project URL)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Server-only secret key. Either the new "sb_secret_..." secret key or the
# legacy "service_role" JWT (Project Settings → API keys).
# NEVER expose this in the browser / NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=sb_secret_...

# Storage bucket for AR assets (created by the migration SQL)
SUPABASE_STORAGE_BUCKET=ar-assets

# Canonical public URL of the deployed app. QR codes and share links use
# this. Must be HTTPS for camera/AR to work on phones.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
