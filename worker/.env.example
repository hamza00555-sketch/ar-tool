# Copy to .env and fill in, or pass these as -e flags to `docker run`.
# WORKER_TOKEN must match the same variable set on the app (Vercel).

APP_URL=https://your-app.vercel.app
WORKER_TOKEN=change-me-to-a-long-random-secret

# Optional
POLL_SECONDS=5
WORK_DIR=./_scan_work
